{
  "$schema": "https://opencode.ai/config.json",
  "model": "${MODEL_MAIN}",
  "small_model": "${MODEL_CHEAP}",
  "autoupdate": false,
  "experimental": {
    "subagent_depth": 3
  },
  "instructions": [
    "~/.config/opencode/rules/*.md"
  ],
  "permission": {
    "edit": "allow",
    "write": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "skill": {
      "*": "allow"
    },
    "bash": {
      "*": "allow"
    }
  },
  "policies": [
    { "action": "tool.use", "resource": "shell:git add*", "effect": "${GIT_COMMIT_PERMISSION}" },
    { "action": "tool.use", "resource": "shell:git commit*", "effect": "${GIT_COMMIT_PERMISSION}" },
    { "action": "tool.use", "resource": "shell:git push*", "effect": "${GIT_OPERATIONS_PERMISSION}" },
    { "action": "tool.use", "resource": "shell:git pull*", "effect": "${GIT_OPERATIONS_PERMISSION}" },
    { "action": "tool.use", "resource": "shell:git fetch*", "effect": "${GIT_OPERATIONS_PERMISSION}" },
    { "action": "tool.use", "resource": "shell:git merge*", "effect": "${GIT_OPERATIONS_PERMISSION}" },
    { "action": "tool.use", "resource": "shell:git rebase*", "effect": "${GIT_OPERATIONS_PERMISSION}" },
    { "action": "tool.use", "resource": "shell:git checkout*", "effect": "${GIT_OPERATIONS_PERMISSION}" },
    { "action": "tool.use", "resource": "shell:git switch*", "effect": "${GIT_OPERATIONS_PERMISSION}" },
    { "action": "tool.use", "resource": "shell:git reset*", "effect": "${GIT_OPERATIONS_PERMISSION}" },
    { "action": "tool.use", "resource": "shell:git restore*", "effect": "${GIT_OPERATIONS_PERMISSION}" },
    { "action": "tool.use", "resource": "shell:git stash*", "effect": "${GIT_OPERATIONS_PERMISSION}" },
    { "action": "tool.use", "resource": "shell:git tag*", "effect": "${GIT_OPERATIONS_PERMISSION}" },
    { "action": "tool.use", "resource": "shell:git cherry-pick*", "effect": "${GIT_OPERATIONS_PERMISSION}" },
    { "action": "tool.use", "resource": "shell:rm -rf /", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:rm -rf /?", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:sudo *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:docker *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push*--force*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push* -f*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push*--delete*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push* -d*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push* :*", "effect": "deny" }
  ],
  "formatter": {
    "phpcbf": {
      "command": ["ssh", "web", "./vendor/bin/phpcbf", "--standard=Drupal,DrupalPractice", "$FILE"],
      "extensions": [".php", ".module", ".inc", ".install", ".theme", ".profile"]
    }
  },
  "mcp": {
    "servers": {
      "playwright": {
        "type": "remote",
        "url": "http://playwright-mcp:8931/mcp",
        "disabled": false,
        "codemode": false,
        "timeout": {
          "catalog": 30000
        }
      }
    }
  },
  "plugin": ["@mohak34/opencode-notifier@latest", "@devtheops/opencode-plugin-otel@latest"]
}
