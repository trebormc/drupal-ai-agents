# =============================================================================
# Model aliases for AI agents
# =============================================================================
# These tokens are replaced by sync.sh when generating agent configs
# for OpenCode and Claude Code containers.
#
# To override, define ONLY the variables you want to change in (variable-level
# cascade, higher wins):
#   ~/.ddev/agents-sync/.env.agents  — all your DDEV projects
#   .ddev/.env.agents                — one project only
#
# Token semantics:
#   GENIUS  — hardest tasks: important code reviews, architecture decisions.
#             Defaults to the SMART model; override with a stronger (more
#             expensive) model when you have one available.
#   SMART   — quality gates, planning, research
#   NORMAL  — day-to-day development and review
#   CHEAP   — exploration, fast tasks
#   APPLIER — mechanical code application
#   VISION  — image/screenshot interpretation. MUST be a model that accepts
#             image input; text-only models cannot see screenshots and will
#             fabricate descriptions. Defaults to the NORMAL model — verify it
#             supports vision or override with one that does.
# =============================================================================

# --- OpenCode models (provider/model-id format) ---
OC_MODEL_GENIUS=opencode/glm-5.2
OC_MODEL_SMART=opencode/glm-5.2
OC_MODEL_NORMAL=opencode/deepseek-v4-pro
OC_MODEL_CHEAP=opencode/deepseek-v4-flash
OC_MODEL_APPLIER=opencode/gpt-5-nano
OC_MODEL_VISION=opencode/minimax-m3

# --- Claude Code models (native aliases) ---
CC_MODEL_GENIUS=opus
CC_MODEL_SMART=opus
CC_MODEL_NORMAL=sonnet
CC_MODEL_CHEAP=haiku
CC_MODEL_APPLIER=haiku
CC_MODEL_VISION=sonnet

# =============================================================================
# Git access flags (per-tool)
# =============================================================================
# Control whether AI agents may run git write commands. Each flag holds a
# COMMA-SEPARATED LIST of the AI tools the capability is granted to. Valid tool
# ids: "opencode", "claude". Leave a flag EMPTY (or null) to grant it to no
# tool — the safe default, where agents present a summary and you commit
# manually. List one or both tools to enable that capability there.
#
# Force-push (--force/-f/--force-with-lease) and remote-branch deletion
# (git push --delete/-d) are ALWAYS blocked, for every tool, whatever these say
# — nothing may rewrite or destroy remote history.
#
#   GIT_ALLOW_COMMIT      git add, git commit
#   GIT_ALLOW_OPERATIONS  git push (non-force), pull, fetch, merge, rebase,
#                         checkout/switch, reset, restore, stash, tag,
#                         cherry-pick
#
# Examples:
#   GIT_ALLOW_COMMIT=opencode,claude   # both tools may commit
#   GIT_ALLOW_OPERATIONS=claude        # only Claude Code may push/pull/...
#   GIT_ALLOW_COMMIT=                  # (empty) no tool may commit
#
# Changes take effect after: ddev agents-update && ddev restart
GIT_ALLOW_COMMIT=
GIT_ALLOW_OPERATIONS=
